@model LegacyOrderPortal.ViewModels.OrderEditViewModel

@{
    ViewBag.Title = "Edit Order";
}

<div class="panel">
    <div class="panel-heading">
        <h3>Edit Order</h3>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.OrderId)
            <div class="form-group">
                @Html.LabelFor(m => m.OrderNumber)
                @Html.TextBoxFor(m => m.OrderNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.OrderNumber)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.CustomerId)
                @Html.DropDownListFor(m => m.CustomerId, Model.Customers, "Select customer", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerId)
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.OrderDate)
                @Html.TextBoxFor(m => m.OrderDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.TotalAmount)
                @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <a class="btn" href="@Url.Action("Index")">Cancel</a>
        }
    </div>
</div>
@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
