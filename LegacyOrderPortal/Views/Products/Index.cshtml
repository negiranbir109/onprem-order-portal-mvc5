@model IEnumerable<LegacyOrderPortal.Models.Product>

@{
    ViewBag.Title = "Products";
}

<div class="panel">
    <div class="panel-heading">
        <h3>Products</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.SKU</td>
                        <td>@product.Price.ToString("C")</td>
                        <td><a href="@Url.Action("Details", new { id = product.ProductId })">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
