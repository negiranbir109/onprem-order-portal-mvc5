@model IEnumerable<LegacyOrderPortal.Models.Customer>

@{
    ViewBag.Title = "Customers";
}

<div class="panel">
    <div class="panel-heading">
        <h3>Customers</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.Email</td>
                        <td>@customer.Phone</td>
                        <td><a href="@Url.Action("Details", new { id = customer.CustomerId })">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
